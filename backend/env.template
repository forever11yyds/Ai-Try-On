# AI-try-on Environment Configuration Template
# Copy this file to .env and fill in the API keys used by the current app.
# cp env.template .env

# ========================================
# Current virtual try-on models
# ========================================

# Google Gemini / Nano Banana family
# Used by: nano-banana, nano-banana-pro
# Get API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Alibaba Cloud DashScope / WanXiang family
# Used by: wan-xiang
# Get API key from: https://help.aliyun.com/zh/model-studio/get-api-key
DASHSCOPE_API_KEY=your api_key

# ========================================
# Optional API server settings
# ========================================

# API_SERVER_PORT=8000
# API_SERVER_HOST=0.0.0.0
# DEBUG=False
# RETURN_MODEL_IMAGE_DIRECTLY=False

# ========================================
# Local MySQL settings
# ========================================

# If you start mysql through docker-compose, these defaults will work on macOS
# because the container maps port 3306 to localhost.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=ai_tryon
MYSQL_USER=ai_tryon
MYSQL_PASSWORD=ai_tryon_password

# SQLAlchemy connection string used by the backend.
DATABASE_URL=mysql+pymysql://ai_tryon:ai_tryon_password@127.0.0.1:3306/ai_tryon?charset=utf8mb4

# To use this template:
# 1. Copy this file: cp env.template .env
# 2. Fill in the keys above
# 3. Never commit the .env file (it's in .gitignore)

